{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "pnpm run test:regression && pnpm run test:unit",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:regression": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "vue-tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "chart.js": "^4.5.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.34",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.2.8"
  },
  "packageManager": "pnpm@11.5.2"
}
